<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>4.0.0</Version>
    <PackageVersion>4.0.0</PackageVersion>
    <AssemblyVersion>4.0.0.0</AssemblyVersion>
    <FileVersion>4.0.0.0</FileVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <PackageId>Gulla.Episerver.AutomaticImageDescription</PackageId>
    <Title>Gulla.Episerver.AutomaticImageDescription</Title>
    <Authors>Tomas Hensrud Gulla</Authors>
    <Description>Automatically populate properties based on image content.</Description>
    <PackageTags>Optimizely Episerver Images</PackageTags>
    <PackageProjectUrl>https://github.com/tomahg/Gulla.Episerver.AutomaticImageDescription/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/tomahg/Gulla.Episerver.AutomaticImageDescription/</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReleaseNotes>Migrate OCR from the retired RecognizePrintedText API to Azure Image Analysis 4.0 Read</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.AI.Vision.ImageAnalysis" Version="[1.0.0, 2.0.0)" />
    <PackageReference Include="EPiServer.CMS.UI.Core" Version="[13.0.1, 14.0.0)" />
    <PackageReference Include="Microsoft.Azure.CognitiveServices.Vision.ComputerVision" Version="[7.0.1, 8.0.0)" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
</Project>